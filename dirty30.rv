
fn frequencies(arr: table<any>) -> table<any, int> do
    let freq_table = {}
    for ele in arr do
        if freq_table:has?(ele) do
            freq_table[ele] += 1
        end else do
            freq_table[ele] = 1
        end
    end
    return freq_table
end

fn ascii_histogram(arr: table<int>, max_bar_length: int) do
    const freqs: table<int, int> = frequencies(arr)
    const max_count: int = freqs:values():sort():last()
    const roll_totals: table<int> = freqs:keys():sort()
    for total in roll_totals do
        const freq: int = freqs[total]
        const proportion: number = freq / len(arr)
        const bar_len: int = freq |> _ / max_count |> _ * max_bar_length |> math.ceil()
        #print(fmt("%v\t%v\t%v%%\t%v", total, freq, 100.0 * proportion, string.mul("+", bar_len)))
        print(fmt("%v\t%v\t%v", total, freq, string.repeat("+", bar_len)))
    end
end

fn rolld6() rng.rand(6)

fn rollnd6(n: int) iter.range(n):map(fn(i) rolld6())

fn dirty30_rec(num_dice: int, num_rolls: int) -> int do
    if num_dice == 0
        num_rolls
    else
        dirty30_rec(
            rollnd6(num_dice):count(fn(roll) roll < 6),
            num_rolls + 1
        )
end

fn dirty30_iter(num_dice: int, num_rolls: int) -> int do
    let num_rolls: int = 0
    let remaining_dice: int = num_dice
    let sixes: int = 0

    while remaining_dice > 0 do
        sixes = 0
        for i in 0..remaining_dice do
            if rolld6() == 6 do
                sixes += 1
            end
        end
        remaining_dice -= sixes
        num_rolls += 1
    end

    return num_rolls
end

const num_runs = 10000
iter.range(num_runs)
    :map(fn(i) dirty30_iter(30, 0))
    #:map(fn(i) dirty30_rec(30, 0))
    :collect()
    |> ascii_histogram(40)
